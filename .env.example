# Секретный токен Telegram-бота из @BotFather. Не добавляйте его в Git
# и никогда не используйте в переменных с префиксом NEXT_PUBLIC_ или VITE_.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Числовой ID закрытой группы, куда бот отправляет заявки.
# A leading minus is optional: the server adds it for numeric group IDs.
TELEGRAM_CHAT_ID=1000000000000
