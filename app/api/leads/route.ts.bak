type LeadPayload = {
  name?: unknown;
  phone?: unknown;
  tariff?: unknown;
};

type LeadServiceEnv = {
  LEADS_SERVICE_URL?: string;
  LEADS_API_KEY?: string;
};

const phonePattern = /^[0-9+()\-\s]+$/;
const allowedTariffs = new Set(["Стандарт", "Премиум", "Широкие"]);

function jsonError(message: string, status: number) {
  return Response.json({ error: message }, { status });
}

async function getRuntimeConfig() {
  let bindings: LeadServiceEnv = {};
  try {
    const cloudflare = await import("cloudflare:workers");
    bindings = cloudflare.env as unknown as LeadServiceEnv;
  } catch {
    // Local Node-based tests do not provide the Cloudflare runtime module.
  }
  return {
    serviceUrl: bindings.LEADS_SERVICE_URL || process.env.LEADS_SERVICE_URL,
    apiKey: bindings.LEADS_API_KEY || process.env.LEADS_API_KEY,
  };
}

function normalizePayload(payload: LeadPayload) {
  const name = typeof payload.name === "string" ? payload.name.trim() : "";
  const phone = typeof payload.phone === "string" ? payload.phone.trim() : "";
  const tariff = typeof payload.tariff === "string" ? payload.tariff.trim() : null;

  if (name.length < 2 || name.length > 100) return null;
  if (phone.length < 5 || phone.length > 30 || !phonePattern.test(phone)) return null;
  if ((phone.match(/\d/g) ?? []).length < 5) return null;
  if (tariff && !allowedTariffs.has(tariff)) return null;

  return { name, phone, tariff: tariff || null };
}

function getLeadEndpoint(serviceUrl: string) {
  const endpoint = new URL(serviceUrl);
  const path = endpoint.pathname.replace(/\/+$/, "");
  if (!path.endsWith("/api/leads")) endpoint.pathname = `${path}/api/leads`;
  endpoint.search = "";
  endpoint.hash = "";
  return endpoint;
}

export async function POST(request: Request) {
  const contentLength = Number(request.headers.get("content-length") ?? 0);
  if (contentLength > 4096) return jsonError("Слишком большой запрос", 413);

  const origin = request.headers.get("origin");
  if (origin && origin !== new URL(request.url).origin) return jsonError("Запрос отклонён", 403);

  let input: LeadPayload;
  try {
    input = await request.json() as LeadPayload;
  } catch {
    return jsonError("Некорректные данные заявки", 400);
  }

  const lead = normalizePayload(input);
  if (!lead) return jsonError("Проверьте имя и номер телефона", 400);

  const { serviceUrl, apiKey } = await getRuntimeConfig();
  if (!serviceUrl) return jsonError("Сервис заявок временно недоступен", 503);

  let endpoint: URL;
  try {
    endpoint = getLeadEndpoint(serviceUrl);
    const isLocalHttp = endpoint.protocol === "http:" && ["localhost", "127.0.0.1", "::1"].includes(endpoint.hostname);
    if (endpoint.protocol !== "https:" && !isLocalHttp) throw new Error("Unsupported protocol");
  } catch {
    return jsonError("Сервис заявок временно недоступен", 503);
  }

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 10_000);

  try {
    const headers: Record<string, string> = { "Content-Type": "application/json" };
    if (apiKey) headers["X-API-Key"] = apiKey;

    const response = await fetch(endpoint, {
      method: "POST",
      headers,
      body: JSON.stringify(lead),
      signal: controller.signal,
    });

    if (!response.ok) return jsonError("Не удалось передать заявку", 502);
    return Response.json({ status: "accepted" }, { status: 201 });
  } catch {
    return jsonError("Не удалось передать заявку", 502);
  } finally {
    clearTimeout(timeout);
  }
}
